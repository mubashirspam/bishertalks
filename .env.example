# Copy to .env.local for local dev, and set the same keys in
# Vercel → Settings → Environment Variables for production.
# No real values in this file — it is committed to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Key id and secret must be from the SAME mode (both test, or both live).
# Local: rzp_test_*   Production: rzp_live_*
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_URL=https://bishertalks.com/api/webhook/razorpay

# Magic Checkout. Leave false until Razorpay enables it on the account —
# otherwise every order fails with 400 "one_click_checkout ... should not be
# sent". See MAGIC_CHECKOUT.md.
NEXT_PUBLIC_MAGIC_CHECKOUT=false

# Support WhatsApp number shown on the thank-you page (country code, no +).
# PLACEHOLDER — replace with the real number or customers message nobody.
NEXT_PUBLIC_SUPPORT_WHATSAPP=916282680794


# ── App ──────────────────────────────────────────────────────────────────────
# Local: http://localhost:3000   Production: https://bishertalks.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOK_PRICE_PAISE=49900
ADMIN_EMAIL=

# ── WhatsApp automation (Meta Cloud API) ─────────────────────────────────────
# The app sends the customer messages itself, in Malayalam, from approved
# templates. Leave the token blank and nothing is sent — orders still complete,
# it just logs a skip. Full setup procedure: META_WHATSAPP.md
#
# 'meta' or 'make'. Unset means Meta as soon as a token exists, which is also
# the rollback switch: set it to 'make' to fall back to the old scenario.
WHATSAPP_PROVIDER=meta
# Permanent System User token (whatsapp_business_messaging +
# whatsapp_business_management). The 24-hour one from the API Setup page will
# stop sending overnight.
WHATSAPP_TOKEN=
# From WhatsApp Manager → API Setup. A long number, NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account id — only needed to submit templates.
WHATSAPP_WABA_ID=
# App Settings → Basic → App Secret. Without it every delivery receipt is
# rejected as unsigned and messages sit at "sent" forever.
WHATSAPP_APP_SECRET=
# Any string you invent, pasted into the webhook config in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional. Pin the Graph API version; bump when Meta deprecates one.
WHATSAPP_API_VERSION=v21.0

# ── WhatsApp automation (Make.com) — being retired ───────────────────────────
# Only read when WHATSAPP_PROVIDER=make. Delete once Meta has run clean for a
# few days. Old procedure: MAKE_WHATSAPP.md
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sends the receipt + course-access email after a paid order. Leave the key
# blank and nothing is sent — the order still completes, it just logs a skip.
RESEND_API_KEY=
# MUST be a domain verified in Resend. An unverified sender is rejected, and
# that is by far the most common reason this appears to do nothing.
# The domain here MUST be the one verified in Resend. Verifying
# send.bishertalks.com and sending from @bishertalks.com is rejected with a
# 403 — the two must match exactly.
RESEND_FROM=Bisher KC <orders@send.bishertalks.com>
# Where customer replies go. Without it, replies bounce off the sender address.
SUPPORT_EMAIL=

# ── Meta Pixel ───────────────────────────────────────────────────────────────
# Ad tracking. Production falls back to the hardcoded ID in app/layout.tsx, so
# this is only needed to override it or to enable the pixel in development.
#
# Comma-separate to track from more than one ad account at once — every event
# is reported into all of the pixels listed here:
#   NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1059545799769579,<second-pixel-id>
# Listing a second ID here replaces the hardcoded fallback, so keep the first
# one in the list or it stops firing.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ── Google Analytics ─────────────────────────────────────────────────────────
# GA4 measurement ID, from analytics.google.com → Admin → Data streams → your
# web stream. Looks like G-XXXXXXXXXX. Leave it BLANK in .env.local: with no ID
# the tag never loads, which is what keeps `npm run dev` sessions out of the
# real property. Set it in Vercel for production.
#
# Comma-separate to load more than one Google tag — a Google Ads conversion ID
# belongs here too, and every event is then reported into both:
#   NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX,AW-XXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── ImageKit (landing page media) ────────────────────────────────────────────
# Testimonial videos, WhatsApp screenshots, voice notes and the explainer video
# are uploaded from Admin → Landing page straight to ImageKit; the app only
# stores the resulting URL.
#
# Find all three at imagekit.io → Developer options → API keys.
# The private key must NEVER be prefixed NEXT_PUBLIC_ — that would ship it to
# every browser and let anyone upload to your account.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ── Shipping ─────────────────────────────────────────────────────────────────
# Return address printed on every parcel label (admin → Delivery → Print).
# A courier that can't deliver sends the parcel back here, so keep it real.
SHIP_FROM_NAME=Bisher KC
SHIP_FROM_ADDRESS=
SHIP_FROM_PHONE=

# ── Internal ─────────────────────────────────────────────────────────────────
# Signs the course-access cookie. Changing it logs out every course user.
INTERNAL_API_SECRET=

# ── Delhivery (optional) ─────────────────────────────────────────────────────
# Without these the shop works exactly as before: parcels are assigned to a
# courier and handed over, and the Excel sheet still downloads. Setting them
# turns on the Send button on /admin/delivery.
#
# Every value here comes from Delhivery — see docs/delhivery-integration-plan.md,
# Phase 0, for the questions to ask them.

# staging | production. Defaults to staging; production is opt-in on purpose.
DELHIVERY_ENV=staging
DELHIVERY_API_TOKEN=
# Delhivery's registered name for our account. Must match theirs exactly.
DELHIVERY_CLIENT_NAME=
# Mandatory on every shipment they create.
DELHIVERY_SELLER_GST=
# HSN code for a paperback book — usually 4901, confirm with them.
DELHIVERY_HSN_CODE=
# The only thing protecting /api/webhook/delhivery: they do not sign payloads.
# openssl rand -hex 32
DELHIVERY_WEBHOOK_SECRET=
# Only used by scripts/delhivery-smoke.mjs. The app reads the pickup location
# from the courier's settings in /admin/couriers instead.
DELHIVERY_PICKUP_LOCATION=

# Guards /api/cron/courier-poll, which asks Delhivery where parcels are.
CRON_SECRET=

# ── India Post / Speed Post (optional) ───────────────────────────────────────
# The Customer Selfservice Portal login at app.indiapost.gov.in — the same
# username and password a person signs in with, not a separate API key.
# See docs/india-post-integration-plan.md.
#
# Calls are refused unless the calling machine's IP is on the whitelist in that
# portal, for sandbox as well as production. That is the first thing to check
# when everything returns 403.
INDIA_POST_ENV=sandbox
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=
# Ten digits. The sandbox account and the contractual production account are
# different numbers — sandbox is issued by the portal, production comes with
# the contract.
INDIA_POST_CUSTOMER_ID=
# Eight digits, per service. Speed Post has its own.
INDIA_POST_CONTRACT_ID=
# Only set to override the host, e.g. when they issue a separate production one.
INDIA_POST_BASE_URL=
# The event webhook has no signature and no header field — their portal offers
# only a URL box. So the secret IS the URL: this value becomes the last path
# segment, and the whole URL is as sensitive as a password.
#   https://www.bishertalks.com/api/webhook/india-post/<INDIA_POST_WEBHOOK_SECRET>
INDIA_POST_WEBHOOK_SECRET=
